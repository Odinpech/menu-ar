
export default {
  async fetch(request, env) {
    const origin = request.headers.get("Origin") || "";

    // Cambia este dominio por el dominio publicado de tu app Softr.
    const allowedOrigin = https://odinprueba.softr.app;

    const headers = {
      "Content-Type": "application/json; charset=utf-8",
      "Access-Control-Allow-Origin":
        origin === allowedOrigin ? origin : "null",
      "Vary": "Origin"
    };

    if (request.method === "OPTIONS") {
      return new Response(null, {
        headers: {
          ...headers,
          "Access-Control-Allow-Methods": "GET, OPTIONS",
          "Access-Control-Allow-Headers": "Content-Type"
        }
      });
    }

    const url = new URL(request.url);

    if (request.method !== "GET" || url.pathname !== "/api/menu") {
      return Response.json(
        { error: "Ruta no encontrada" },
        { status: 404, headers }
      );
    }

    if (origin !== allowedOrigin) {
      return Response.json(
        { error: "Origen no autorizado" },
        { status: 403, headers }
      );
    }

    const apiUrl = new URL(
      "https://api.airtable.com/v0/" +
      encodeURIComponent(env.AIRTABLE_BASE_ID) + "/" +
      encodeURIComponent(env.AIRTABLE_TABLE)
    );

    apiUrl.searchParams.set("pageSize", "100");
    apiUrl.searchParams.set("filterByFormula", "{Activo}=1");

    try {
      const response = await fetch(apiUrl, {
        headers: {
          Authorization: `Bearer ${env.AIRTABLE_TOKEN}`
        }
      });

      if (!response.ok) {
        return Response.json(
          { error: "Error al consultar Airtable" },
          { status: 502, headers }
        );
      }

      const data = await response.json();

      const records = data.records.map(record => {
        const f = record.fields || {};
        const urlDeImagen = value =>
          typeof value === "string"
            ? value
            : Array.isArray(value) ? value[0]?.url || "" : "";

        return {
          nombre: f.Nombre || "",
          descripcion: f.Descripcion || "",
          categoria: f.Categoria || "",
          precio: f.Precio || 0,
          imagen: urlDeImagen(f.ImagenURL),
          glb: f.ModeloGLB || "",
          usdz: f.ModeloUSDZ || ""
        };
      });

      return Response.json({ records }, {
        headers: {
          ...headers,
          "Cache-Control": "public, max-age=60"
        }
      });
    } catch {
      return Response.json(
        { error: "No fue posible consultar el menú" },
        { status: 500, headers }
      );
    }
  }
};
